# =============================================================================
# Odisea Mental — Configuración local (pgAdmin / PostgreSQL)
# Copia este archivo como ".env" en la raíz y ajusta tus valores.
# =============================================================================

# --- PostgreSQL (pgAdmin) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=odisea_mental
PGUSER=postgres
PGPASSWORD=tu_contraseña_de_postgres

# --- API local (Express) ---
PORT=3001

# --- Frontend (Vite) ---
# Usa /api para que Vite redirija al servidor local (proxy en vite.config.ts)
VITE_API_URL=/api

# --- Supabase (dejar vacío mientras uses PostgreSQL local) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
